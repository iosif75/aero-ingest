          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT coalesce(nullif(callsign, ''), '(none)') AS callsign, icao24,\n  count(*) AS positions,\n  round(max(baro_altitude)) AS max_alt_m,\n  max(time_position) AS last_seen\nFROM state_vectors\nWHERE $__timeFilter(time_position)\nGROUP BY 1, 2\nORDER BY positions DESC\nLIMIT 20"
