          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT DISTINCT ON (icao24)\n  icao24, coalesce(nullif(callsign, ''), icao24) AS callsign,\n  latitude, longitude, baro_altitude, true_track, velocity * 3.6 AS speed_kmh, on_ground, time_position\nFROM state_vectors\nWHERE time_position BETWEEN $__timeTo()::timestamptz - interval '10 minutes' AND $__timeTo()\nORDER BY icao24, time_position DESC"
