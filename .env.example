# Path to the credentials.json downloaded from your OpenSky account page.
# Keep it outside this repo, e.g. ~/.config/aero-ingest/credentials.json
OPENSKY_CREDENTIALS_FILE=C:/Users/you/.config/aero-ingest/credentials.json

# Or set the values directly instead of using the file:
# OPENSKY_CLIENT_ID=your-client-id
# OPENSKY_CLIENT_SECRET=your-client-secret

# Bounding box (defaults: roughly 0.8 x 1.2 degrees around El Prat / BCN)
# AERO_LAMIN=40.9
# AERO_LOMIN=1.5
# AERO_LAMAX=41.7
# AERO_LOMAX=2.7

# Poll interval in seconds (default 60)
# AERO_POLL_INTERVAL_SECS=60

# Log level: info shows counts per poll, debug shows every aircraft
RUST_LOG=aero_ingest=info

# Postgres from `docker compose up -d`. Leave unset to run in log-only mode.
DATABASE_URL=postgres://aero:aero@localhost:5432/aero
