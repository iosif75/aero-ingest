# Path to the credentials.json downloaded from your OpenSky account page.
# Keep it outside this repo, e.g. ~/.config/aero-ingest/credentials.json
OPENSKY_CREDENTIALS_FILE=C:/Users/you/.config/aero-ingest/credentials.json

# Or set the values directly instead of using the file:
# OPENSKY_CLIENT_ID=your-client-id
# OPENSKY_CLIENT_SECRET=your-client-secret

# Bounding box (defaults: Aero-Scan's region, 39.3-43.3 N, 0-5 E, 1 credit a poll)
# AERO_LAMIN=39.3
# AERO_LOMIN=0
# AERO_LAMAX=43.3
# AERO_LOMAX=5

# Poll interval in seconds (default 60)
# AERO_POLL_INTERVAL_SECS=60

# Address for /health, /metrics, the query API and the /polls feed (default 127.0.0.1:9090)
# AERO_HTTP_ADDR=127.0.0.1:9090

# Delete positions older than this many days (default 30, 0 keeps everything)
# AERO_RETENTION_DAYS=30

# Docker on Linux only: run the container as the owner of credentials.json
# when that file is chmod 600 (use the output of `id -u` and `id -g`).
# AERO_UID=1000
# AERO_GID=1000

# Monitoring profile: Grafana admin password (default admin) and how long
# Prometheus keeps metrics (default 30d)
# GRAFANA_ADMIN_PASSWORD=change-me
# PROMETHEUS_RETENTION=30d

# Log level: info shows counts per poll, debug shows every aircraft
RUST_LOG=aero_ingest=info

# Postgres from `docker compose up -d`. Leave unset to run in log-only mode.
DATABASE_URL=postgres://aero:aero@localhost:5432/aero
